  "vo": [
    {"id": "s1",     "at": 0.15, "text": "I opened an ancient Egyptian tomb… and accidentally woke up a 3,000-year-old mummy!"},
    {"id": "s2",     "at": 5.55, "text": "I was exploring an Egyptian pyramid when I found a mysterious golden door."},
    {"id": "s3",     "at": 12.3, "text": "Inside was a giant golden coffin. Naturally, I opened it. What could possibly go wrong?"},
    {"id": "s4",     "at": 19.35,"text": "Suddenly, two glowing eyes appeared in the darkness. The mummy was ALIVE!"},
    {"id": "scream", "at": 24.2, "text": "AAAAAAH!"},
    {"id": "s5",     "at": 26.7, "text": "It started chasing me through the pyramid! I ran faster than I had ever run in my entire life!"},
    {"id": "s6a",    "at": 33.35,"text": "Then it stopped… and asked me where the bathroom was."},
    {"id": "s6b",    "at": 35.75,"text": "WHAT?!"},
    {"id": "s6c",    "at": 36.45,"text": "Subscribe to History World for more historical disasters!"}
