 "vo": [
  {
   "id": "s1",
   "at": 0.1,
   "text": "THE ENTIRE CITY IS BURNING! And I just woke up in 1666!"
  },
  {
   "id": "s2",
   "at": 4.3,
   "text": "I was walking through London when suddenly, people started screaming. Fire was spreading everywhere!"
  },
  {
   "id": "s3",
   "at": 11.3,
   "text": "It all started in a small bakery on Pudding Lane. But nobody expected what would happen next."
  },
  {
   "id": "s4",
   "at": 18.3,
   "text": "The wooden houses were catching fire one after another. The wind was pushing the flames across the city!"
  },
  {
   "id": "s5",
   "at": 27.3,
   "text": "I tried to escape, but every street looked like a giant wall of fire. Even the famous old St. Paul's Cathedral was destroyed!"
  },
  {
   "id": "s6",
   "at": 36.6,
   "text": "Four days later, most of the medieval city was in ruins. I thought I had escaped history\u2026"
  },
  {
   "id": "s7a",
   "at": 44.15,
   "text": "Then my time machine said:"
  },
  {
   "id": "s7b",
   "at": 45.45,
   "text": "DESTINATION: POMPEII."
  },
  {
   "id": "s7c",
   "at": 47.4,
   "text": "WAIT\u2026 NOT AGAIN!"
  }
 ],
